{
  "description": "/runner path-sanity gate + Codex wiki refresh on session start.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/user-prompt-submit-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/refresh-wikis.sh\"",
            "async": true,
            "statusMessage": "Refreshing Codex wiki repos"
          }
        ]
      }
    ]
  }
}

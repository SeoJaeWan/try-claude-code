{
  "description": "Sync statusline files to ~/.claude/statusline/ on session start.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/sync-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

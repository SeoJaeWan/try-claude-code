{
  "name": "try-claude-code",
  "version": "2.4.0",
  "description": "Codex Workbench plugin development workspace",
  "type": "module",
  "scripts": {
    "codex-plugin:deploy": "node codex-plugin/scripts/deploy-workbench-plugin.mjs",
    "test": "npm run test:workbench",
    "test:workbench": "npm run test:dev-wiki-graph && npm run test:openapi",
    "test:dev-wiki-graph": "node --test codex-plugin/plugins/workbench/skills/dev-wiki/scripts/__tests__/generate-dev-wiki-graph.test.mjs",
    "test:openapi": "ruby codex-plugin/plugins/workbench/tools/__tests__/openapi-mcp.test.rb"
  }
}
